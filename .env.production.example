# Production analytics keys. Copy to .env.production (gitignored) for local
# prod-mode testing, or set the same names as repository secrets in GitHub
# Actions for deploys. If a value is missing the matching provider stays off.

# Google Analytics 4 measurement ID — format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# PostHog project API key (public, safe to ship in the bundle)
VITE_POSTHOG_KEY=

# Optional. Defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com
# for EU-region projects, or your self-hosted instance URL.
VITE_POSTHOG_HOST=
