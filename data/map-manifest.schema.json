{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "map-manifest.schema.json",
  "type": "object",
  "required": ["groups"],
  "additionalProperties": false,
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "maps"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "maps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file"],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
