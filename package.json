{
  "name": "battle-city-reforged",
  "version": "0.1.0",
  "description": "Battle City (1985, Namco) remake in TypeScript. Up to 4 players, 3 difficulties, 17 achievements, level editor, and more.",
  "private": true,
  "license": "MIT",
  "author": "Daniel Derevjanik",
  "contributors": [
    "Michael Radionov <mradionov.oss@gmail.com> (https://github.com/mradionov)"
  ],
  "homepage": "https://github.com/dderevjanik/battle-city-reforged/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dderevjanik/battle-city-reforged.git"
  },
  "bugs": {
    "url": "https://github.com/dderevjanik/battle-city-reforged/issues"
  },
  "keywords": [
    "battle-city",
    "game",
    "typescript",
    "phaser",
    "vite",
    "pwa",
    "browser-game",
    "retro",
    "nes"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite --open",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage 'src/**/*.test.ts'",
    "nes:import": "tsx scripts/nes-import.ts",
    "nes:extract-sprites": "tsx scripts/nes-extract-sprites.ts"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "phaser": "^4.0.0",
    "posthog-js": "^1.373.2"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vite-plugin-static-copy": "^4.0.1"
  }
}
